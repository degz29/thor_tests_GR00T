+class LayerProfiler(trt.IProfiler):
+    """Adds up TRT's per-layer times (ms) over all runs of one engine."""
+    def __init__(self):
+        trt.IProfiler.__init__(self)
+        self.t = {}
+
+    def report_layer_time(self, layer_name, ms):
+        self.t[layer_name] = self.t.get(layer_name, 0.0) + ms
+
+
+def layer_category(name):
+    n = name.lower()
+    if any(k in n for k in ("fmha", "mha", "attention", "softmax", "flash")):
+        return "attention"
+    if any(k in n for k in ("matmul", "gemm", "conv")):
+        return "gemm"
+    if any(k in n for k in ("norm", "reducemean", "rsqrt")):
+        return "norm"
+    if "cast" in n:
+        return "cast"
+    if any(k in n for k in ("reformat", "copy", "shuffle", "transpose", "concat", "slice",
+                            "gather", "scatter", "reshape", "nonzero")):
+        return "data movement"
+    if "myl" in n:
+        return "fused elementwise"
+    if any(k in n for k in ("quantize", "dequant", "qdq", "fp4", "fp8")):
+        return "quantize"
+    return "other"
+
+
+def print_profiles():
+    for eng in PROFILED:
+        if eng.n_runs == 0:
+            continue
+        per_run = {k: v / eng.n_runs for k, v in eng.prof.t.items()}
+        total = sum(per_run.values())
+        print(f"\n=== {os.path.basename(eng.file)}: {eng.n_runs} runs, "
+              f"{total:.3f} ms per run (profiler on) ===")
+        cats = {}
+        for name, ms in per_run.items():
+            c = layer_category(name)
+            cats[c] = cats.get(c, 0.0) + ms
+        for c, ms in sorted(cats.items(), key=lambda x: -x[1]):
+            print(f"  {c:<20}{ms:8.3f} ms {100 * ms / total:6.1f}%")
+        print("  slowest layers:")
+        for name, ms in sorted(per_run.items(), key=lambda x: -x[1])[:10]:
+            print(f"    {ms:7.3f} ms  [{layer_category(name)}]  {name[:100]}")
+atexit.register(print_profiles)
 
